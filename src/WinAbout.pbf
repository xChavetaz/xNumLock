Global WinAbout

Global Image_0, Text_0, Text_1, Text_2, Hyperlink_0, Editor_1, Hyperlink_2, Hyperlink_3

Global Img_WinAbout_0

UsePNGImageDecoder()

Img_WinAbout_0 = LoadImage(#PB_Any,"C:\Users\arxa2\OneDrive\Devs\PureBasic\xNumLock\_recursos\xnum_64x64-32.png")

Enumeration FormFont
  #Font_WinAbout_0
EndEnumeration

LoadFont(#Font_WinAbout_0,"Segoe UI", 10, #PB_Font_Bold | #PB_Font_Italic)

Declare SiteLinkEvent(EventType)
Declare PayLinkEvent(EventType)

Procedure OpenWinAbout(x = 0, y = 0, width = 304, height = 232)
  WinAbout = OpenWindow(#PB_Any, x, y, width, height, Language::Get("MenuTray","About"), #PB_Window_SystemMenu | #PB_Window_ScreenCentered)
  Image_0 = ImageGadget(#PB_Any, 8, 10, 64, 64, ImageID(Img_WinAbout_0))
  Text_0 = TextGadget(#PB_Any, 120, 2, 176, 22, Version)
  SetGadgetFont(Text_0, FontID(#Font_WinAbout_0))
  Text_1 = TextGadget(#PB_Any, 136, 24, 144, 18, "by Rodrigo Salomone")
  Text_2 = TextGadget(#PB_Any, 136, 40, 144, 18, "xsalomone@gmail.com")
  Hyperlink_0 = HyperLinkGadget(#PB_Any, 61, 81, 203, 18, "sites.google.com/view/xsalomone", 0, #PB_HyperLink_Underline)
  SetGadgetColor(Hyperlink_0, #PB_Gadget_FrontColor,RGB(0,0,255))
  Editor_1 = EditorGadget(#PB_Any, 0, 152, 304, 80, #PB_Editor_ReadOnly | #PB_Editor_WordWrap)
  Hyperlink_2 = HyperLinkGadget(#PB_Any, 8, 112, 296, 20, "xNumLock is developed on my spare time.", 0, #PB_HyperLink_Underline)
  SetGadgetColor(Hyperlink_2, #PB_Gadget_FrontColor,RGB(0,0,255))
  Hyperlink_3 = HyperLinkGadget(#PB_Any, 8, 130, 296, 20, "If you like please pay me a beer", 0, #PB_HyperLink_Underline)
  SetGadgetColor(Hyperlink_3, #PB_Gadget_FrontColor,RGB(0,0,255))
EndProcedure

Procedure WinAbout_Events(event)
  Select event
    Case #PB_Event_CloseWindow
      ProcedureReturn #False

    Case #PB_Event_Menu
      Select EventMenu()
      EndSelect

    Case #PB_Event_Gadget
      Select EventGadget()
        Case Hyperlink_0
          SiteLinkEvent(EventType())          
        Case Hyperlink_2
          PayLinkEvent(EventType())          
        Case Hyperlink_3
          PayLinkEvent(EventType())          
      EndSelect
  EndSelect
  ProcedureReturn #True
EndProcedure

